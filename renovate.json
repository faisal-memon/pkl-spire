{
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchPackageNames": ["ghcr.io/spiffe/spire-server"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^src\\/compose\\/Deployment\\.pkl$/"],
      "matchStrings": [
        "version: String\\(matches\\(Regex\\(\\\"[^\\\"]+\\\"\\)\\)\\) = \\\"(?<currentValue>[^\\\"]+)\\\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/spiffe/spire-server"
    }
  ]
}
