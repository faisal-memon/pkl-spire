/// Map typed server settings into SPIRE JSON.
open module spire.render.ServerConfig

import "../core/Server.pkl"

settings: Server

output {
  value = new Dynamic {
    server {
      bind_address = "0.0.0.0"
      bind_port = settings.port
      trust_domain = settings.trustDomain
      data_dir = settings.dataDir
      socket_path = settings.socketPath
      log_level = settings.logLevel
    }
    health_checks {
      listener_enabled = settings.healthChecksEnabled
      bind_address = settings.healthBindAddress
      bind_port = settings.healthPort
      live_path = settings.livePath
      ready_path = settings.readyPath
    }
    plugins {
      DataStore {
        sql { plugin_data { database_type = "sqlite3"; connection_string = settings.dataDir + "/datastore.sqlite3" } }
      }
      KeyManager { disk { plugin_data { keys_path = settings.dataDir + "/keys.json" } } }
      NodeAttestor { join_token { plugin_data = new Dynamic {} } }
      BundlePublisher = if (settings.customBundlePublisher != null) new Dynamic {
        disk {
          plugin_cmd = settings.customBundlePublisher.command
          plugin_checksum = settings.customBundlePublisher.checksum
          plugin_data { directory = settings.customBundlePublisher.directory; format = "pem"; filename = "bundle.pem" }
        }
      } else null
    }
  }
  renderer = new JsonRenderer {}
}
